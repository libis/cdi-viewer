{
  "env": {
    "browser": true,
    "es2021": true,
    "jquery": true,
    "jest": true,
    "node": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "globals": {
    "N3": "readonly",
    "jsonld": "readonly",
    "SHACLValidator": "readonly",
    "jsonData": "writable",
    "shaclShapesStore": "writable",
    "isEditMode": "writable",
    "cachedLocalContext": "writable",
    "validationViolations": "writable",
    "currentSearchTerm": "writable",
    "currentFilterShaclOnly": "writable",
    "LOG_LEVEL": "writable",
    "log": "readonly",
    "normalizeToGraphFormat": "readonly",
    "loadLocalContext": "readonly",
    "buildViewerContext": "readonly",
    "resolvePrefix": "readonly",
    "expandCompactIri": "readonly",
    "loadShapes": "readonly",
    "parseShapes": "readonly",
    "jsonLdToN3Store": "readonly",
    "parseRdfList": "readonly",
    "extractLabelFromUri": "readonly",
    "getEnumerationValues": "readonly",
    "classifyProperty": "readonly",
    "validateData": "readonly",
    "updatePropertyValidation": "readonly",
    "renderData": "readonly",
    "extractNodeReferences": "readonly",
    "isNodeReference": "readonly",
    "renderNodeTree": "readonly",
    "renderNode": "readonly",
    "renderPropertyTree": "readonly",
    "renderProperty": "readonly",
    "createValueInput": "readonly",
    "humanizeKey": "readonly",
    "highlightText": "readonly",
    "getPropertySuggestions": "readonly",
    "createPropertySuggestionsSection": "readonly",
    "collectChangesFromDOM": "readonly",
    "saveChanges": "readonly",
    "saveToDataverse": "readonly",
    "exportData": "readonly",
    "updateSaveButton": "readonly",
    "setupEventHandlers": "readonly",
    "getExpandedNodeId": "readonly",
    "getExpandedPropertyUri": "readonly",
    "getAvailableNodeTypes": "readonly",
    "addRootNode": "readonly",
    "createAndAddRootNode": "readonly",
    "addPropertyToNode": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-undef": "error",
    "no-redeclare": "off",
    "no-use-before-define": ["error", { "functions": false }],
    "eqeqeq": ["warn", "always"],
    "curly": ["warn", "all"],
    "no-var": "warn",
    "prefer-const": "warn",
    "no-throw-literal": "error"
  }
}
