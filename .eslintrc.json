{
  "env": {
    "browser": true,
    "es2021": true,
    "jquery": true,
    "jest": true,
    "node": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "globals": {
    "N3": "readonly",
    "jsonld": "readonly",
    "LOG_LEVEL": "writable",
    "log": "readonly",
    "validateData": "readonly",
    "SHAPE_URLS": "readonly",
    "state": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", { "args": "all", "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-undef": "error",
    "no-redeclare": "warn",
    "no-use-before-define": ["error", { "functions": false }],
    "eqeqeq": ["warn", "always"],
    "curly": ["warn", "all"],
    "no-var": "warn",
    "prefer-const": "warn",
    "no-throw-literal": "error"
  }
}
